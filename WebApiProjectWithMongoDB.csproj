<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Enables `dotnet user-secrets` for this project so the connection string
         never has to live in a file you might commit. -->
    <UserSecretsId>WebApiProjectWithMongoDB-secrets</UserSecretsId>

    <!-- The XML doc comments throughout this template are there to be read, but
         they'd otherwise produce CS1591 warnings on public members. This keeps
         the build clean without hiding genuine warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- .NET 10's OpenAPI support reads the XML doc file at build time and copies
         your <summary> comments into the generated OpenAPI document, so the
         descriptions you write above each action show up in Scalar for free. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />

    <!-- Renders the OpenAPI document as a browsable UI at /scalar/v1 in
         development. Swap for Swashbuckle or NSwag if you prefer. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />

  </ItemGroup>

  <ItemGroup>
    <!-- Keep the template's own config out of the compiled project output. -->
    <Content Remove=".template.config\**" />
    <None Include=".template.config\**" />
  </ItemGroup>

</Project>
