<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Enables `dotnet user-secrets` for this project so the connection string
         never has to live in a file you might commit. -->
    <UserSecretsId>WebApiProjectWithMongoDB-secrets</UserSecretsId>

    <!-- The XML doc comments throughout this template are there to be read, but
         they'd otherwise produce CS1591 warnings on public members. This keeps
         the build clean without hiding genuine warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />

    <!-- Renders the OpenAPI document as a browsable UI at /scalar/v1 in
         development. Swap for Swashbuckle or NSwag if you prefer. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />

    <!-- Pinned directly to pull a patched version forward. Microsoft.AspNetCore.OpenApi
         10.0.0 brings in Microsoft.OpenApi 2.0.0 transitively, which carries a known
         high-severity advisory (GHSA-v5pm-xwqc-g5wc). Remove this line once the
         ASP.NET Core package references a fixed version itself. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the template's own config out of the compiled project output. -->
    <Content Remove=".template.config\**" />
    <None Include=".template.config\**" />
  </ItemGroup>

</Project>
